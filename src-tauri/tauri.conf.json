{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevOrches",
  "version": "0.0.1",
  "identifier": "com.devorches.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DevOrches",
        "resizable": true,
        "fullscreen": false,
        "width": 1024,
        "height": 768,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
